type Query {
    usuarios: [Usuario!]!
    usuario(id: ID!): Usuario!
    musicas: [Musica!]!
    musica(id: ID!): Musica!
    playlists: [Playlist!]!
    playlist(id: ID!): Playlist!
    playlistsDoUsuario(usuarioId: ID!): [Playlist!]!
    musicasDaPlaylist(playlistId: ID!): [Musica!]!
    playlistsDaMusica(musicaId: ID!): [Playlist!]!
}

type Mutation {
    criarUsuario(input: UsuarioInput!): Usuario!
    atualizarUsuario(id: ID!, input: UsuarioInput!): Usuario!
    excluirUsuario(id: ID!): Boolean!
    criarMusica(input: MusicaInput!): Musica!
    atualizarMusica(id: ID!, input: MusicaInput!): Musica!
    excluirMusica(id: ID!): Boolean!
    criarPlaylist(input: PlaylistInput!): Playlist!
    atualizarPlaylist(id: ID!, input: PlaylistInput!): Playlist!
    excluirPlaylist(id: ID!): Boolean!
}

type Usuario {
    id: ID!
    nome: String
    idade: Int
}

type Musica {
    id: ID!
    nome: String
    artista: String
}

type Playlist {
    id: ID!
    nome: String
    usuarioId: ID!
    musicaIds: [ID!]!
}

input UsuarioInput {
    nome: String
    idade: Int
}

input MusicaInput {
    nome: String
    artista: String
}

input PlaylistInput {
    nome: String
    usuarioId: ID!
    musicaIds: [ID!]
}
